<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reportSembako" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">
    <queryString>
        <![CDATA[SELECT * FROM sembako]]>
    </queryString>
    <field name="id" class="java.lang.Integer"/>
    <field name="nama_barang" class="java.lang.String"/>
    <field name="satuan" class="java.lang.String"/>
    <field name="harga" class="java.lang.Double"/>
    <field name="stok" class="java.lang.Integer"/>
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN DATA SEMBAKO]]></text>
            </staticText>
        </band>
    </title>
    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="40" height="25" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font isBold="true"/></textElement>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement x="40" y="0" width="200" height="25" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font isBold="true"/></textElement>
                <text><![CDATA[Nama Barang]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="0" width="80" height="25" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font isBold="true"/></textElement>
                <text><![CDATA[Satuan]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="120" height="25" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font isBold="true"/></textElement>
                <text><![CDATA[Harga]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="0" width="115" height="25" backcolor="#CCCCCC"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font isBold="true"/></textElement>
                <text><![CDATA[Stok]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="40" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="40" y="0" width="200" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$F{nama_barang}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="240" y="0" width="80" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{satuan}]]></textFieldExpression>
            </textField>
            <textField pattern="Rp #,##0">
                <reportElement x="320" y="0" width="120" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{harga}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="440" y="0" width="115" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{stok}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <pageFooter>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="200" height="20"/>
                <text><![CDATA[Dicetak oleh: Sistem Sembako]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="355" y="0" width="200" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>